# Database
POSTGRES_URL=postgresql://dev_user:dev_password@localhost:5432/postgres_dev

# Authentication - Better Auth
# Generate key using https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=qtD4Ssa0t5jY7ewALgai97sKhAtn7Ysc

# Google OAuth (Get from Google Cloud Console)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (Get from Facebook Developers Console)
# Redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# AI Integration via OpenRouter (Optional - for chat functionality)
# Get your API key from: https://openrouter.ai/settings/keys
# View available models at: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL="openai/gpt-5-mini"

# Optional - for vector search only
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# App URL (for production deployments)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File storage (optional - if app required file uploads)
BLOB_READ_WRITE_TOKEN=

# Stripe payment processing
# Get these from: https://dashboard.stripe.com/apikeys (use test mode keys first)
STRIPE_SECRET_KEY=sk_test_
# Webhook signing secret: dashboard endpoint config (prod) or `stripe listen` (dev)
STRIPE_WEBHOOK_SECRET=whsec_
# Price IDs from the Stripe dashboard (create products/prices first)
# Subscription plans (recurring)
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BYOK_PRO=
# Credit packs (one-time purchases)
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_50=
STRIPE_PRICE_CREDITS_100=

# Mailgun Email Service
# Get these from: https://app.mailgun.com/app/sending/domains
# 1. Add your domain to Mailgun (Settings > Sending Domains > Add New Domain)
# 2. Configure DNS records for domain verification
# 3. Verify domain in Mailgun dashboard
# 4. Get API key from Settings > API Keys
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
EMAIL_FROM="FreddyBeach <noreply@freddybeach.com>"

# Admin notification email (receives new business submissions)
ADMIN_EMAIL=

# AI Image Generation (Gemini)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=
# 32-byte hex string for AES-256-GCM encryption of user API keys
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Token limits per subscription tier (monthly)
FREE_TIER_IMAGE_TOKENS=10
ENHANCED_TIER_IMAGE_TOKENS=50
FEATURED_TIER_IMAGE_TOKENS=200

# Soft Cap Enforcement for Subscription Users
# When true, blocks generation after 500 monthly uses
# When false (default), only shows warnings at 80%+ usage
ENFORCE_SOFT_CAP=false
